# Skopiuj do .env.local i uzupełnij. Nigdy nie commituj .env.local.

# Supabase (publiczne: mogą trafić do przeglądarki)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (tylko serwer)
SUPABASE_SERVICE_ROLE_KEY=

# Adres aplikacji (linki w e-mailach i publiczne strony ofert)
NEXT_PUBLIC_APP_URL=http://localhost:3000
